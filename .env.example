# =============================================================================
# Network Monitor - Environment Configuration Example
# Copy this file to .env and fill in your values
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
SECRET_KEY=change_me_to_a_random_secret

# ---------------------------------------------------------------------------
# Telegram Bot
# ---------------------------------------------------------------------------
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Your Telegram chat/user ID (or group ID) to receive alerts
TELEGRAM_ADMIN_CHAT_ID=

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/network_monitor

# Sync URL used by Alembic only
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/network_monitor

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Cisco Bootstrap Device (Main Switch/Router)
# ---------------------------------------------------------------------------
# The primary Cisco device that serves as the discovery starting point
CISCO_BOOTSTRAP_NAME=core-switch
CISCO_BOOTSTRAP_HOST=
CISCO_BOOTSTRAP_SSH_PORT=22
CISCO_BOOTSTRAP_USERNAME=
CISCO_BOOTSTRAP_PASSWORD=
CISCO_BOOTSTRAP_ENABLE_PASSWORD=

# Cisco device type for Netmiko (cisco_ios, cisco_xe, cisco_nxos)
CISCO_BOOTSTRAP_DEVICE_TYPE=cisco_ios

# ---------------------------------------------------------------------------
# Discovery Settings
# ---------------------------------------------------------------------------
DISCOVERY_ENABLED=true
# Interval in seconds between full topology re-discoveries
DISCOVERY_INTERVAL_SECONDS=3600

# Enable specific discovery protocols
ENABLE_CDP_DISCOVERY=true
ENABLE_LLDP_DISCOVERY=true
ENABLE_ARP_DISCOVERY=true
ENABLE_MAC_TABLE_DISCOVERY=true

# Auto-probe discovered neighbor devices
AUTO_PROBE_MIKROTIK=true
AUTO_PROBE_UBNT=true
AUTO_PROBE_CISCO=true

# Default credentials to try when probing discovered devices
DEFAULT_DEVICE_USERNAME=
DEFAULT_DEVICE_PASSWORD=
DEFAULT_DEVICE_ENABLE_PASSWORD=

# ---------------------------------------------------------------------------
# Polling Settings
# ---------------------------------------------------------------------------
# Interval in seconds between each device poll cycle
POLL_INTERVAL_SECONDS=60

# SSH connection timeout (seconds)
SSH_TIMEOUT=30

# Number of connection retry attempts
SSH_RETRIES=3

# ---------------------------------------------------------------------------
# Alert Thresholds
# ---------------------------------------------------------------------------
# Minimum acceptable CCQ percentage (Ubiquiti/wireless)
THRESHOLD_CCQ_MIN=70

# Minimum acceptable signal level (dBm)
THRESHOLD_SIGNAL_MIN=-75

# Maximum acceptable packet loss percentage
THRESHOLD_PACKET_LOSS_PERCENT=20

# Number of reconnects before raising an alert
THRESHOLD_RECONNECT_COUNT=5

# Maximum acceptable interface error rate (errors per poll)
THRESHOLD_INTERFACE_ERROR_RATE=50

# Maximum acceptable interface discard rate (discards per poll)
THRESHOLD_INTERFACE_DISCARDS=20

# ---------------------------------------------------------------------------
# Alert Deduplication & Debounce
# ---------------------------------------------------------------------------
# Seconds before a repeated identical alert can fire again
ALERT_DEBOUNCE_SECONDS=300

# Seconds of grace period before a "recovery" alert is sent
RECOVERY_GRACE_SECONDS=120

# Maximum alerts to keep in database per device
MAX_ALERTS_PER_DEVICE=1000

# ---------------------------------------------------------------------------
# MikroTik Defaults (used if auto-probed device is MikroTik)
# ---------------------------------------------------------------------------
MIKROTIK_DEFAULT_API_PORT=8728
MIKROTIK_DEFAULT_API_SSL_PORT=8729
MIKROTIK_DEFAULT_SSH_PORT=22

# ---------------------------------------------------------------------------
# UBNT / airOS Defaults
# ---------------------------------------------------------------------------
UBNT_DEFAULT_SSH_PORT=22
UBNT_DEFAULT_SNMP_PORT=161
UBNT_DEFAULT_SNMP_VERSION=2c
UBNT_DEFAULT_SNMP_COMMUNITY=public
